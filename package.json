{
  "name": "dnd-character-generator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:scrape": "tsx scripts/test-scrape.ts",
    "scrape:all": "tsx scripts/scrape-dnd2024.ts --type all",
    "scrape:spells": "tsx scripts/scrape-dnd2024.ts --type spells",
    "scrape:subclasses": "tsx scripts/scrape-dnd2024.ts --type subclasses",
    "scrape:feats": "tsx scripts/scrape-dnd2024.ts --type feats",
    "scrape:backgrounds": "tsx scripts/scrape-dnd2024.ts --type backgrounds",
    "scrape:targeted": "tsx scripts/scrape-dnd2024.ts --continue-on-error",
    "validate:spells": "tsx scripts/validate-output.ts --type spells",
    "validate:subclasses": "tsx scripts/validate-output.ts --type subclasses",
    "validate:feats": "tsx scripts/validate-output.ts --type feats",
    "validate:backgrounds": "tsx scripts/validate-output.ts --type backgrounds",
    "validate:species": "tsx scripts/validate-output.ts --type species",
    "parse:srd-pdf": "tsx scripts/parse-srd-pdf.ts",
    "query:srd": "tsx scripts/query-srd.ts"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^24.12.0",
    "@types/puppeteer": "^5.4.7",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "autoprefixer": "^10.4.27",
    "axios": "^1.13.6",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "pdf-parse": "^1.1.1",
    "postcss": "^8.5.8",
    "puppeteer": "^24.40.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "yargs": "^17.7.2"
  }
}
