{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "D&D 2024 Spell Progression",
  "description": "Schema for validating D&D 2024 SRD spell progression data extracted from wikidot.com class pages",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["name", "spellcastingAbility", "cantripsKnown", "spellsPreparedFormula", "spellSlots"],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "description": "Class name (e.g., 'bard', 'wizard')"
      },
      "spellcastingAbility": {
        "type": "string",
        "enum": ["intelligence", "wisdom", "charisma"],
        "description": "Primary spellcasting ability for the class"
      },
      "cantripsKnown": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0
        },
        "minItems": 20,
        "maxItems": 20,
        "description": "Number of cantrips known at each character level (index = level - 1)"
      },
      "spellsPreparedFormula": {
        "type": "string",
        "description": "Formula for calculating spells prepared (e.g., 'level + modifier') or empty string if using fixed chart"
      },
      "spellsPrepared": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0
        },
        "minItems": 20,
        "maxItems": 20,
        "description": "Number of spells prepared at each character level (index = level - 1), used for classes with fixed charts like Bard"
      },
      "spellSlots": {
        "type": "array",
        "items": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 20,
          "maxItems": 20
        },
        "description": "Spell slot progression by spell level (index = spell level - 1, each inner array indexed by character level - 1)"
      },
      "baseSpellsKnown": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0
        },
        "description": "Initial spells known at level 1 (for classes like Bard/Sorcerer)"
      }
    },
    "additionalProperties": false
  },
  "examples": [
    {
      "name": "bard",
      "spellcastingAbility": "charisma",
