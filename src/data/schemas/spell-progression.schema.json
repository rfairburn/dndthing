{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "D&D 2024 Spell Progression",
  "description": "Schema for validating D&D 2024 SRD spell progression data extracted from wikidot.com",
  "type": "object",
  "required": ["unifiedSpellSlots", "artificer", "barbarian", "bard", "cleric", "druid", "fighter", "monk", "paladin", "ranger", "rogue", "sorcerer", "warlock", "wizard"],
  "properties": {
    "unifiedSpellSlots": {
      "type": "object",
      "description": "Multiclass spellcaster spell slots table - source of truth for all spellcasters",
      "patternProperties": {
        "^[1-9][0-9]$": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 9,
          "maxItems": 9,
          "description": "Spell slots by level (indices 0-8 represent spell levels 1-9)"
        }
      },
      "minProperties": 20,
      "maxProperties": 20
    },
    "artificer": {
      "type": "object",
      "required": ["name", "spellcastingAbility", "cantripsKnown", "spellsPrepared", "baseSpellsKnown"],
      "properties": {
        "name": { "type": "string" },
        "spellcastingAbility": { "type": "string" },
        "cantripsKnown": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "spellsPrepared": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "baseSpellsKnown": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "spellSlots": { "type": "array" }
      },
      "additionalProperties": false
