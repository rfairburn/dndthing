{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "D&D 2024 Spell",
  "description": "Schema for validating D&D 2024 SRD spell data extracted from wikidot.com",
  "type": "object",
  "required": ["name", "level", "school", "castingTime", "range", "components", "duration", "description", "classes"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Official spell name"
    },
    "level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9,
      "description": "Spell level (0 for cantrips)"
    },
    "school": {
      "type": "string",
      "enum": [
        "abjuration",
        "conjuration",
        "divination",
        "enchantment",
        "evocation",
        "illusion",
        "necromancy",
        "transmutation"
      ],
      "description": "Spell school"
    },
    "castingTime": {
      "type": "string",
      "minLength": 1,
      "description": "Casting time (e.g., '1 action', '1 minute or Ritual')"
    },
    "range": {
      "type": "string",
      "minLength": 1,
      "description": "Spell range (e.g., '60 feet', 'Touch', 'Self')"
    },
    "components": {
      "type": "object",
      "properties": {
        "verbal": {
          "type": "boolean"
        },
        "somatic": {
          "type": "boolean"
        },
        "material": {
          "type": "boolean"
        },
        "materialCost": {
          "type": "number",
          "minimum": 0,
          "description": "Optional material component cost in gold pieces"
        }
      },
      "minProperties": 1,
      "additionalProperties": false,
      "description": "Spell components (at least one must be true)"
    },
    "duration": {
      "type": "string",
      "minLength": 1,
      "description": "Spell duration"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "Full spell description text"
    },
    "atHigherLevels": {
      "type": "string",
      "description": "Optional: Spell effects at higher levels"
    },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "artificer",
          "barbarian",
          "bard",
          "cleric",
          "druid",
          "fighter",
          "monk",
          "paladin",
          "ranger",
          "rogue",
          "sorcerer",
          "warlock",
          "wizard"
        ]
      },
      "description": "List of classes that can cast this spell"
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "name": "Acid Splash",
      "level": 0,
      "school": "evocation",
      "castingTime": "Action",
      "range": "60 feet",
      "components": {
        "verbal": true,
        "somatic": true,
        "material": false
      },
      "duration": "Instantaneous",
      "description": "You create an acidic bubble at a point within range, where it explodes in a 5-foot-radius Sphere. Each creature in that Sphere must succeed on a Dexterity saving throw or take 1d6 Acid damage.",
      "classes": ["artificer", "sorcerer", "wizard"]
    },
    {
      "name": "Chill Touch",
      "level": 0,
      "school": "necromancy",
      "castingTime": "Action",
      "range": "Touch",
      "components": {
        "verbal": true,
        "somatic": true,
        "material": false
      },
      "duration": "Instantaneous",
      "description": "Channeling the chill of the grave, make a melee spell attack against a target within reach. On a hit, the target takes 1d10 Necrotic damage, and it can't regain Hit Points until the end of your next turn.",
      "classes": ["sorcerer", "warlock", "wizard"]
    }
  ]
}
